---
import Base from '../layouts/Base.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import GalleryCard from '../components/GalleryCard.astro';
import Packages from '../components/Packages.astro';
import HowItWorks from '../components/HowItWorks.astro';
import KindWords from '../components/KindWords.astro';
import FAQ from '../components/FAQ.astro';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { getGalleries, getPosts, fmtDate } from '../lib';
const site = (await getEntry('site', 'home'))!.data;
const all = await getGalleries();
const featured = (all.some((g) => g.data.featured) ? all.filter((g) => g.data.featured) : all).slice(0, 6);
const posts = (await getPosts()).slice(0, 3);
---
<Base>
  <HeroSlideshow images={site.heroImages} eyebrow={`${site.location} Photographer`} title={site.tagline} galleryHref="/galleries/" connectHref="#connect" />

  {site.categories.length > 0 && (
    <nav class="pills wrap" aria-label="Browse by session type">
      {site.categories.map((c) => <a href={`/galleries/?cat=${encodeURIComponent(c)}`}>{c}</a>)}
    </nav>
  )}

  <section class="section center wrap intro">
    <p class="eyebrow">Hello there</p>
    <h2>{site.intro}</h2>
  </section>

  {featured.length > 0 && (
    <section class="section wrap tight">
      <div class="head"><div><p class="eyebrow">Portfolio</p><h2>Recent galleries</h2></div><a class="btn" href="/galleries/">View all</a></div>
      <div class="grid-cards">{featured.map((g) => <GalleryCard g={g} />)}</div>
    </section>
  )}

  <Packages />

  <HowItWorks />

  <FAQ />

  <KindWords />

  {site.services.length > 0 && (
    <section class="section services">
      <div class="wrap">
        <p class="eyebrow center">What I photograph</p>
        <div class="svc-grid">
          {site.services.map((s) => (<div class="svc"><h3>{s.name}</h3><p>{s.description}</p></div>))}
        </div>
      </div>
    </section>
  )}

  <section id="about" class="section">
    <div class="wrap about-grid">
      {site.aboutImage && <Image src={site.aboutImage} alt={`${site.photographer}, photographer`} widths={[500, 900]} sizes="(max-width: 800px) 100vw, 45vw" />}
      <div>
        <p class="eyebrow">About</p>
        <h2>Meet {site.photographer}</h2>
        {site.about.split(/\n\s*\n/).map((p) => <p>{p}</p>)}
        <a class="btn solid" href="#connect">Let's work together</a>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section wrap tight">
      <div class="head"><div><p class="eyebrow">Journal</p><h2>From the blog</h2></div><a class="btn" href="/blog/">All posts</a></div>
      <div class="grid-cards">
        {posts.map((p) => (
          <a class="card" href={`/blog/${p.id}/`}>
            {(p.data.cover ?? p.data.photos[0]) && <div class="img" style="aspect-ratio:3/2"><Image src={(p.data.cover ?? p.data.photos[0])!} alt={p.data.title} widths={[400, 700]} sizes="(max-width: 700px) 100vw, 400px" /></div>}
            <h3>{p.data.title}</h3><p class="meta">{fmtDate(p.data.date)}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
<style>
  .pills { display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem; padding-top: 1.75rem; padding-bottom: .25rem; }
  .pills a { text-decoration: none; border: 1px solid #4a3f33; color: var(--ink); border-radius: 999px; padding: .55rem 1.2rem; font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; font-weight: 450; background: var(--paper); transition: all .2s; }
  .pills a:hover { background: var(--accent); color: var(--cream); border-color: var(--accent); }
  .intro { padding-top: 3rem; }
  .intro h2 { max-width: 820px; margin: 0 auto; font-weight: 400; }
  .tight { padding-top: 0; }
  .services { background: var(--paper); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .svc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2.5rem; margin-top: 1.5rem; text-align: center; }
  .svc p { color: var(--muted); margin: 0; }
  .head { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap; }
  .head h2 { margin: 0; }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .about-grid img { aspect-ratio: 4/5; object-fit: cover; width: 100%; }
  @media (max-width: 800px) { .about-grid { grid-template-columns: 1fr; gap: 2rem; } }
</style>
