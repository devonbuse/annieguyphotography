---
import '../styles/global.css';
import Connect from '../components/Connect.astro';
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';

interface Props { title?: string; description?: string; image?: ImageMetadata; hideConnect?: boolean; overlayHeader?: boolean }
const site = (await getEntry('site', 'home'))!.data;
const { title, description = site.intro, image, hideConnect = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.businessName}` : `${site.businessName} | ${site.location} Photographer`;
const og = await getImage({ src: image ?? site.heroImages[0], width: 1200, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).href;
const nav: [string, string][] = [['Galleries', '/galleries/'], ['Pricing', '/#packages'], ['Blog', '/blog/'], ['About', '/#about'], ['Contact', '/contact/']];
const path = Astro.url.pathname;
const tel = site.phone.replace(/[^\d+]/g, '');
const connectHref = hideConnect ? '#inquiry' : '#connect';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogUrl} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#171410" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap bar">
      <a href="/" class="logo">{site.businessName}</a>
      <nav id="nav">
        {nav.map(([label, href]) => (
          <a href={href} aria-current={!href.includes('#') && path.startsWith(href) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <a class="btn solid book" href={connectHref}><span class="long">Book a session</span><span class="short">Book</span></a>
      <button class="menu-btn" aria-label="Menu" aria-controls="nav" aria-expanded="false"><span></span><span></span></button>
    </div>
  </header>

  <main id="main"><slot /></main>

  {!hideConnect && <Connect />}

  <footer class="site-footer">
    <div class="wrap">
      <p class="logo">{site.businessName}</p>
      <p>{site.photographer} · {site.location} Photographer</p>
      <p class="links">
        {site.instagram && <a href={site.instagram} rel="noopener">Instagram</a>}
        {site.facebook && <a href={site.facebook} rel="noopener">Facebook</a>}
        {site.phone && <a href={`tel:${tel}`}>{site.phone}</a>}
        {site.email && <a href={`mailto:${site.email}`}>Email</a>}
      </p>
      <p class="small">© {new Date().getFullYear()} {site.businessName}</p>
    </div>
  </footer>

  <!-- Small, polite mobile bar: appears after scrolling, hides when the form is already on screen. No pop-ups. -->
  <div class="quickbar" aria-label="Contact shortcuts">
    {site.phone && <a href={`tel:${tel}`}>Call</a>}
    {site.messenger && <a href={site.messenger} rel="noopener">Message</a>}
    <a href={connectHref} class="primary">Inquire</a>
  </div>

  <script>
    const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
    const nav = document.getElementById('nav')!;
    btn.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { nav.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); }));

    const bar = document.querySelector<HTMLElement>('.quickbar')!;
    const target = document.getElementById('connect') ?? document.getElementById('inquiry');
    let formVisible = false;
    if (target) new IntersectionObserver(([e]) => { formVisible = e.isIntersecting; update(); }).observe(target);
    const update = () => bar.classList.toggle('show', window.scrollY > 500 && !formVisible);
    addEventListener('scroll', update, { passive: true });
  </script>
</body>
</html>
<style>
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; z-index: 200; background: var(--paper); padding: .5rem 1rem; }
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(23,20,16,.95); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 2rem; height: 68px; }
  .logo { font-family: var(--serif); font-size: 1.5rem; text-decoration: none; letter-spacing: .01em; color: var(--accent); margin: 0; white-space: nowrap; }
  nav { display: flex; gap: 1.8rem; margin-left: auto; }
  nav a { text-decoration: none; font-size: .78rem; letter-spacing: .18em; text-transform: uppercase; font-weight: 450; padding: .3rem 0; border-bottom: 1px solid transparent; }
  nav a:hover, nav a[aria-current] { border-color: var(--accent); }
  .book { padding: .7rem 1.2rem; font-size: .72rem; white-space: nowrap; }
  .book .short { display: none; }
  .menu-btn { display: none; background: none; border: 0; width: 44px; height: 44px; cursor: pointer; position: relative; }
  .menu-btn span { position: absolute; left: 11px; right: 11px; height: 1.5px; background: var(--accent); }
  .menu-btn span:first-child { top: 17px; } .menu-btn span:last-child { top: 25px; }
  @media (max-width: 1000px) {
    .bar { gap: .5rem; }
    .logo { font-size: 1.3rem; margin-right: auto; }
    .book { padding: .6rem .9rem; font-size: .7rem; letter-spacing: .12em; }
    .book .long { display: none; } .book .short { display: inline; }
    .menu-btn { display: block; }
    nav { display: none; position: absolute; top: 68px; left: 0; right: 0; flex-direction: column; gap: 0; background: var(--cream); border-bottom: 1px solid var(--line); }
    nav.open { display: flex; }
    nav a { padding: 1rem 1.25rem; border-bottom: 1px solid var(--line); }
  }
  @media (max-width: 380px) { .book { display: none; } }
  .site-footer { background: var(--deep); color: var(--muted); border-top: 1px solid var(--line); text-align: center; padding: 3.5rem 0 5.5rem; font-size: .92rem; }
  .site-footer .logo { color: var(--accent); font-size: 2rem; }
  .site-footer p { margin: .4rem 0; }
  .links a { margin: 0 .7rem; color: var(--ink); }
  .small { opacity: .7; font-size: .8rem; margin-top: 1.5rem !important; }
  .quickbar { display: none; }
  @media (max-width: 820px) {
    .quickbar { display: flex; position: fixed; left: .75rem; right: .75rem; bottom: .75rem; z-index: 60; background: #2a241d; border: 1px solid var(--accent); border-radius: 999px; overflow: hidden; box-shadow: 0 6px 24px rgba(0,0,0,.5); transform: translateY(150%); transition: transform .35s ease; }
    .quickbar.show { transform: none; }
    .quickbar a { flex: 1; text-align: center; padding: .9rem .5rem; color: var(--ink); text-decoration: none; font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 450; }
    .quickbar a + a { border-left: 1px solid rgba(255,255,255,.18); }
    .quickbar a.primary { background: var(--accent); color: var(--cream); }
  }
</style>
