---
// Masonry photo grid + full-screen viewer (tap to open, swipe/arrow keys to move).
import { Image, getImage } from 'astro:assets';
interface Props { photos: ImageMetadata[]; label: string }
const { photos, label } = Astro.props;
const items = await Promise.all(photos.map(async (src, i) => ({
  src,
  alt: `${label} — photo ${i + 1}`,
  full: (await getImage({ src, width: Math.min(2000, src.width), format: 'webp', quality: 80 })).src,
})));
---
<div class="masonry" data-grid>
  {items.map((p) => (
    <a href={p.full} class="ph">
      <Image src={p.src} alt={p.alt} widths={[400, 700, 1000].filter((w) => w <= p.src.width)} sizes="(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 400px" />
    </a>
  ))}
</div>
<div class="lb" hidden role="dialog" aria-label="Photo viewer">
  <button class="x" aria-label="Close">×</button>
  <button class="prev" aria-label="Previous">‹</button>
  <img alt="" />
  <button class="next" aria-label="Next">›</button>
</div>
<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-grid] .ph')];
  const lb = document.querySelector<HTMLDivElement>('.lb');
  if (lb && links.length) {
    const img = lb.querySelector('img')!;
    let i = 0;
    const show = (n: number) => {
      i = (n + links.length) % links.length;
      img.src = links[i].href;
      img.alt = links[i].querySelector('img')?.alt ?? '';
      lb.hidden = false; document.body.style.overflow = 'hidden';
      new Image().src = links[(i + 1) % links.length].href; // preload next
    };
    const close = () => { lb.hidden = true; document.body.style.overflow = ''; };
    links.forEach((a, n) => a.addEventListener('click', (e) => { e.preventDefault(); show(n); }));
    lb.querySelector('.x')!.addEventListener('click', close);
    lb.querySelector('.prev')!.addEventListener('click', () => show(i - 1));
    lb.querySelector('.next')!.addEventListener('click', () => show(i + 1));
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });
    let x0: number | null = null;
    lb.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    lb.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) show(i + (dx < 0 ? 1 : -1));
      x0 = null;
    });
  }
</script>
<style>
  .lb { position: fixed; inset: 0; z-index: 100; background: rgba(20,16,14,.96); display: flex; align-items: center; justify-content: center; }
  .lb[hidden] { display: none; }
  .lb img { max-width: 92vw; max-height: 88vh; object-fit: contain; }
  .lb button { position: absolute; background: none; border: 0; color: #fff; font-size: 2.6rem; cursor: pointer; padding: 1rem; line-height: 1; }
  .x { top: .5rem; right: .75rem; }
  .prev { left: .25rem; top: 50%; transform: translateY(-50%); }
  .next { right: .25rem; top: 50%; transform: translateY(-50%); }
</style>
