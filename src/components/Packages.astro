---
import { getEntry } from 'astro:content';
const site = (await getEntry('site', 'home'))!.data;
---
{site.packages.length > 0 && (
  <section id="packages" class="section packages">
    <div class="wrap">
      <div class="center">
        <p class="eyebrow">Packages</p>
        <h2>Simple, clear pricing</h2>
        <p class="sub">Every session includes a private online gallery for your photos. Questions? Message me and I'll gladly walk you through it.</p>
      </div>
      <div class="grid">
        {site.packages.map((p) => (
          <div class:list={['pkg', { popular: p.popular }]}>
            {p.label && <p class="label">{p.label}</p>}
            <h3>{p.name}</h3>
            <p class="price">{p.price}</p>
            <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
            <a class:list={['btn', { solid: p.popular }]} href="#connect" data-pkg={p.name}>Book {p.name}</a>
          </div>
        ))}
      </div>
      {site.packagesNote && <p class="note center">{site.packagesNote}</p>}
    </div>
  </section>
)}
<script>
  // Pre-select the chosen package in the inquiry form.
  document.querySelectorAll<HTMLAnchorElement>('[data-pkg]').forEach((a) => a.addEventListener('click', () => {
    document.querySelectorAll<HTMLSelectElement>('form[data-lead] select').forEach((s) => {
      const o = [...s.options].find((o) => o.value === a.dataset.pkg || o.text.startsWith(a.dataset.pkg!));
      if (o) s.value = o.value;
    });
  }));
</script>
<style>
  .packages { background: var(--paper); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .sub { color: var(--muted); max-width: 600px; margin: 0 auto; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin-top: 2.5rem; align-items: stretch; }
  .pkg { border: 1px solid var(--line); background: var(--cream); padding: 2rem 1.75rem; text-align: center; display: flex; flex-direction: column; }
  .pkg.popular { border: 1.5px solid var(--ink); background: #fff; }
  .label { margin: 0 0 .4rem; font-size: .72rem; letter-spacing: .2em; text-transform: uppercase; color: var(--accent); font-weight: 450; }
  .pkg h3 { font-size: 1.9rem; margin: 0; }
  .price { font-family: var(--serif); font-size: 2.6rem; margin: .4rem 0 1rem; line-height: 1; }
  ul { list-style: none; padding: 0; margin: 0 0 1.75rem; flex: 1; }
  li { padding: .5rem 0; border-top: 1px solid var(--line); color: #4a403a; }
  li:last-child { border-bottom: 1px solid var(--line); }
  .pkg .btn { align-self: center; }
  .note { margin: 2rem 0 0; font-family: var(--serif); font-style: italic; font-size: 1.3rem; }
</style>
