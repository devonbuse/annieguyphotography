---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
const site = (await getEntry('site', 'home'))!.data;
---
{site.testimonials.length > 0 && (
  <section id="reviews" class="section words">
    <div class="wrap">
      <div class="center"><p class="eyebrow">Testimonials</p><h2>What clients are saying</h2></div>
      <div class="track">
        {site.testimonials.map((t) => (
          <figure>
            {t.photo && <Image src={t.photo} alt={`${t.name}, photographed by Annie`} widths={[360, 480, 720].filter((w) => w <= t.photo!.width)} sizes="(max-width: 700px) 82vw, 360px" />}
            <blockquote>“{t.quote}”</blockquote>
            <figcaption><span class="name">{t.name}</span>{t.detail && <span class="detail">{t.detail}</span>}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .words { background: #2a2520; }
  .track { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2.5rem; margin-top: 2.5rem; }
  figure { margin: 0; text-align: center; display: flex; flex-direction: column; }
  figure img { width: 100%; aspect-ratio: 23 / 20; object-fit: cover; margin-bottom: 1.5rem; }
  blockquote { margin: 0 0 1.2rem; font-size: 1.02rem; line-height: 1.75; color: var(--ink); flex: 1; }
  .name { display: block; font-family: var(--serif); color: var(--accent); font-size: 1.15rem; letter-spacing: .14em; text-transform: uppercase; }
  .detail { display: block; color: var(--muted); font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; margin-top: .2rem; }
  /* Phones: swipe sideways through reviews instead of a long scroll */
  @media (max-width: 700px) {
    .track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 1.25rem; margin: 2rem -1.25rem 0; padding: 0 1.25rem 1rem; scrollbar-width: none; }
    .track::-webkit-scrollbar { display: none; }
    figure { flex: 0 0 82%; scroll-snap-align: center; }
  }
</style>
